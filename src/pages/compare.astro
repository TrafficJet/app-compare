---
import Base from '../layouts/Base.astro';
import { PAIRS } from '../data/pairs';
import { APPS, CATEGORIES } from '../data/apps';

const pairsByCategory: Record<string, typeof PAIRS> = {};
for (const pair of PAIRS) {
  if (!pairsByCategory[pair.category]) pairsByCategory[pair.category] = [];
  pairsByCategory[pair.category].push(pair);
}

const categoryOrder = ['email', 'reviews', 'support', 'shipping', 'subscriptions', 'loyalty', 'analytics'];
const activeCategories = categoryOrder.filter(c => pairsByCategory[c]?.length > 0);
---
<Base
  title="All Shopify App Comparisons — AppCompare.com 2026"
  description={`${PAIRS.length} Shopify app comparisons across email, reviews, support, shipping, subscriptions, loyalty, and analytics. Real pricing and honest verdicts.`}
>
  <div class="mb-8">
    <h1 class="text-3xl font-bold mb-2 text-gray-900 dark:text-gray-100">All Shopify App Comparisons</h1>
    <p class="text-gray-600 dark:text-gray-400">{PAIRS.length} comparisons across {activeCategories.length} categories — with real pricing, feature matrices, and verdicts.</p>
  </div>

  <div class="space-y-6">
    {activeCategories.map(catKey => {
      const cat = CATEGORIES[catKey];
      const pairs = pairsByCategory[catKey];
      return (
        <div class="border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden">
          <div class="flex items-center gap-3 px-5 py-3.5 bg-gray-50 dark:bg-gray-900 border-b border-gray-200 dark:border-gray-700">
            <span class="text-2xl">{cat?.icon}</span>
            <div>
              <div class="font-bold text-gray-900 dark:text-gray-100">{cat?.name}</div>
              <div class="text-xs text-gray-500 dark:text-gray-400">{cat?.description}</div>
            </div>
          </div>
          <div class="divide-y divide-gray-100 dark:divide-gray-800">
            {pairs.map(pair => (
              <a href={`/compare/${pair.slug}/`}
                class="flex items-center justify-between px-5 py-4 hover:bg-blue-50 dark:hover:bg-blue-950 transition-colors group">
                <div class="flex-1 min-w-0">
                  <div class="font-semibold text-gray-900 dark:text-gray-100 group-hover:text-blue-700 dark:group-hover:text-blue-400 mb-0.5">
                    {APPS[pair.app1]?.name} vs {APPS[pair.app2]?.name}
                  </div>
                  <div class="text-sm text-gray-500 dark:text-gray-400 truncate">{pair.verdict}</div>
                </div>
                <div class="flex items-center gap-4 ml-4 shrink-0">
                  <div class="hidden sm:flex flex-col text-xs text-gray-400 dark:text-gray-500 text-right">
                    <span>⭐ {APPS[pair.app1]?.rating} · {APPS[pair.app1]?.reviewCount.toLocaleString()} reviews</span>
                    <span>⭐ {APPS[pair.app2]?.rating} · {APPS[pair.app2]?.reviewCount.toLocaleString()} reviews</span>
                  </div>
                  <span class="text-blue-500 dark:text-blue-400 group-hover:translate-x-0.5 transition-transform text-lg">→</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      );
    })}
  </div>
</Base>
