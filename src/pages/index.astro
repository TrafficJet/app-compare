---
import Base from '../layouts/Base.astro';
import { PAIRS } from '../data/pairs';
import { APPS, CATEGORIES } from '../data/apps';

// Group pairs by category
const pairsByCategory: Record<string, typeof PAIRS> = {};
for (const pair of PAIRS) {
  if (!pairsByCategory[pair.category]) pairsByCategory[pair.category] = [];
  pairsByCategory[pair.category].push(pair);
}

// Sort categories: show only those with pairs, order by volume
const categoryOrder = ['email', 'reviews', 'support', 'shipping', 'subscriptions', 'loyalty', 'analytics'];
const activeCategories = categoryOrder.filter(c => pairsByCategory[c]?.length > 0);

// Top comparisons by search volume
const topPairs = [...PAIRS].sort((a, b) => b.searchVolume - a.searchVolume).slice(0, 6);
---
<Base
  title="Compare Shopify Apps Side by Side — AppCompare.com 2026"
  description="Independent Shopify app comparisons: Klaviyo vs Mailchimp, Judge.me vs Yotpo, Gorgias vs Tidio, and 12 more. Real pricing, feature matrices, and honest verdicts."
>
  <!-- Hero -->
  <section class="text-center py-10 border-b border-gray-100 dark:border-gray-800 mb-10">
    <h1 class="text-4xl font-bold mb-3 text-gray-900 dark:text-gray-100">Find the Best Shopify App</h1>
    <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto mb-6">
      Side-by-side comparisons with real pricing, feature matrices, and honest verdicts. No affiliate bias.
    </p>
    <div class="flex flex-wrap gap-3 justify-center">
      <a href="/compare/klaviyo-vs-mailchimp/" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-lg text-sm font-semibold transition">
        Klaviyo vs Mailchimp →
      </a>
      <a href="/compare/aftership-vs-shipstation/" class="border-2 border-blue-600 text-blue-700 dark:text-blue-400 dark:border-blue-500 hover:bg-blue-50 dark:hover:bg-blue-950 px-5 py-2.5 rounded-lg text-sm font-semibold transition">
        AfterShip vs ShipStation →
      </a>
    </div>
  </section>

  <!-- Top Comparisons -->
  <section class="mb-10">
    <div class="flex items-center gap-3 mb-5">
      <h2 class="text-lg font-bold text-gray-900 dark:text-gray-100">Most Popular Comparisons</h2>
      <span class="text-xs bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300 px-2 py-0.5 rounded-full font-medium">{PAIRS.length} comparisons</span>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {topPairs.map(pair => {
        const cat = CATEGORIES[pair.category];
        return (
          <a href={`/compare/${pair.slug}/`}
            class="group block border border-gray-200 dark:border-gray-700 rounded-xl p-5 hover:border-blue-400 dark:hover:border-blue-600 hover:shadow-md transition-all">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-lg">{cat?.icon}</span>
              <span class="text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wide">{cat?.name}</span>
            </div>
            <h3 class="font-semibold text-gray-900 dark:text-gray-100 group-hover:text-blue-700 dark:group-hover:text-blue-400 transition-colors mb-1">
              {APPS[pair.app1]?.name} vs {APPS[pair.app2]?.name}
            </h3>
            <p class="text-xs text-gray-500 dark:text-gray-400 leading-snug mb-3">{pair.verdict}</p>
            <div class="flex gap-2">
              {APPS[pair.app1]?.pricing.hasFree && (
                <span class="text-xs bg-green-50 dark:bg-green-950 text-green-600 dark:text-green-400 border border-green-200 dark:border-green-800 px-2 py-0.5 rounded-full">{APPS[pair.app1].name} free</span>
              )}
              {APPS[pair.app2]?.pricing.hasFree && (
                <span class="text-xs bg-green-50 dark:bg-green-950 text-green-600 dark:text-green-400 border border-green-200 dark:border-green-800 px-2 py-0.5 rounded-full">{APPS[pair.app2].name} free</span>
              )}
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- Category Hubs -->
  <section class="mb-10">
    <h2 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-5">Browse by Category</h2>
    <div class="space-y-6">
      {activeCategories.map(catKey => {
        const cat = CATEGORIES[catKey];
        const pairs = pairsByCategory[catKey];
        return (
          <div class="border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden">
            <div class="flex items-center gap-3 px-5 py-3 bg-gray-50 dark:bg-gray-900 border-b border-gray-200 dark:border-gray-700">
              <span class="text-xl">{cat?.icon}</span>
              <div>
                <span class="font-semibold text-gray-900 dark:text-gray-100">{cat?.name}</span>
                <span class="text-xs text-gray-400 dark:text-gray-500 ml-2">{pairs.length} comparison{pairs.length > 1 ? 's' : ''}</span>
              </div>
            </div>
            <div class="divide-y divide-gray-100 dark:divide-gray-800">
              {pairs.map(pair => (
                <a href={`/compare/${pair.slug}/`}
                  class="flex items-center justify-between px-5 py-3.5 hover:bg-blue-50 dark:hover:bg-blue-950 transition-colors group">
                  <div>
                    <span class="font-medium text-gray-900 dark:text-gray-100 group-hover:text-blue-700 dark:group-hover:text-blue-400">
                      {APPS[pair.app1]?.name} vs {APPS[pair.app2]?.name}
                    </span>
                    <span class="text-xs text-gray-400 dark:text-gray-500 ml-2 hidden sm:inline">{pair.verdict}</span>
                  </div>
                  <div class="flex items-center gap-3 shrink-0 ml-3">
                    <div class="text-xs text-gray-400 dark:text-gray-500">
                      ⭐ {APPS[pair.app1]?.rating} vs ⭐ {APPS[pair.app2]?.rating}
                    </div>
                    <span class="text-blue-500 dark:text-blue-400 text-sm group-hover:translate-x-0.5 transition-transform">→</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- Trust bar -->
  <div class="flex flex-wrap gap-6 justify-center text-sm text-gray-400 dark:text-gray-500 border-t border-gray-100 dark:border-gray-800 pt-6">
    <span>✓ {PAIRS.length} comparisons</span>
    <span>✓ Real 2026 pricing</span>
    <span>✓ No paid placements</span>
    <span>✓ Updated regularly</span>
  </div>
</Base>
