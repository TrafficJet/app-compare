---
import { BEST_PAGES, type BestPage } from '../../data/bestPages';
import { APPS, CATEGORIES, type AppData } from '../../data/apps';
import { PAIRS } from '../../data/pairs';
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  return BEST_PAGES.map(page => ({
    params: { category: page.slug },
    props: { page },
  }));
}

interface Props { page: BestPage }
const { page } = Astro.props;

const category = CATEGORIES[page.category];
const canonicalUrl = `https://app-compare.com/best/${page.slug}/`;

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faq.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
});

const rankColors = [
  'border-yellow-400 dark:border-yellow-500 bg-yellow-50 dark:bg-yellow-950',
  'border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-900',
  'border-amber-600 dark:border-amber-700 bg-amber-50 dark:bg-amber-950',
];
const rankLabels = ['#1 Best Overall', '#2 Runner-Up', '#3 Also Great'];
const rankBadgeColors = [
  'bg-yellow-400 text-yellow-900',
  'bg-gray-400 text-white',
  'bg-amber-600 text-white',
];
---
<Base title={page.h1} description={page.metaDescription} canonicalUrl={canonicalUrl} noWebAppSchema={true}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <!-- Breadcrumb -->
  <nav class="text-xs text-gray-400 dark:text-gray-500 mb-6 flex items-center gap-1.5 flex-wrap">
    <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400">Home</a>
    <span>/</span>
    <a href="/compare/" class="hover:text-blue-600 dark:hover:text-blue-400">Compare</a>
    <span>/</span>
    <span class="text-gray-600 dark:text-gray-300">Best {category?.name} Apps</span>
  </nav>

  <!-- Hero -->
  <div class="mb-10">
    <div class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950 px-3 py-1 rounded-full mb-4">
      <span>{category?.icon}</span>
      <span>{category?.name}</span>
    </div>
    <h1 class="text-4xl font-bold mb-4 text-gray-900 dark:text-gray-100">{page.h1}</h1>
    <p class="text-lg text-gray-500 dark:text-gray-400 max-w-2xl leading-relaxed">{page.intro}</p>
  </div>

  <!-- Quick comparison table -->
  <section class="mb-10">
    <h2 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-4">Quick Comparison</h2>
    <div class="overflow-x-auto rounded-xl border border-gray-200 dark:border-gray-700">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-gray-50 dark:bg-gray-900 border-b border-gray-200 dark:border-gray-700">
            <th class="text-left px-4 py-3 font-semibold text-gray-600 dark:text-gray-400">App</th>
            <th class="text-center px-3 py-3 font-semibold text-gray-600 dark:text-gray-400 hidden sm:table-cell">Rating</th>
            <th class="text-center px-3 py-3 font-semibold text-gray-600 dark:text-gray-400">Free Plan</th>
            <th class="text-left px-3 py-3 font-semibold text-gray-600 dark:text-gray-400">Starting Price</th>
            <th class="text-center px-3 py-3 font-semibold text-gray-600 dark:text-gray-400">Our Score</th>
          </tr>
        </thead>
        <tbody>
          {page.apps.map((entry, i) => {
            const app = APPS[entry.appId];
            if (!app) return null;
            return (
              <tr class={`border-b border-gray-100 dark:border-gray-800 ${i % 2 === 0 ? 'bg-white dark:bg-gray-950' : 'bg-gray-50 dark:bg-gray-900'}`}>
                <td class="px-4 py-3">
                  <div class="flex items-center gap-2">
                    <span class={`text-xs font-bold px-1.5 py-0.5 rounded ${i < 3 ? rankBadgeColors[i] : 'bg-gray-200 dark:bg-gray-700 text-gray-600 dark:text-gray-300'}`}>#{entry.rank}</span>
                    <span class="font-medium text-gray-900 dark:text-gray-100">{app.name}</span>
                  </div>
                </td>
                <td class="px-3 py-3 text-center hidden sm:table-cell text-amber-600 dark:text-amber-400 font-medium">
                  ⭐ {app.rating}
                </td>
                <td class="px-3 py-3 text-center">
                  {app.pricing.hasFree
                    ? <span class="text-green-600 dark:text-green-400 font-bold">✓</span>
                    : <span class="text-gray-400 dark:text-gray-500">—</span>
                  }
                </td>
                <td class="px-3 py-3 text-gray-700 dark:text-gray-300 text-sm">
                  {app.pricing.hasFree ? 'Free' : `$${app.pricing.startingPrice}/mo`}
                </td>
                <td class="px-3 py-3 text-center">
                  <span class={`font-bold ${entry.score >= 9 ? 'text-green-600 dark:text-green-400' : entry.score >= 8 ? 'text-blue-600 dark:text-blue-400' : 'text-gray-600 dark:text-gray-400'}`}>
                    {entry.score}/10
                  </span>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Ranked app cards -->
  <section class="mb-10 space-y-6">
    <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100">Detailed Rankings</h2>
    {page.apps.map((entry, i) => {
      const app = APPS[entry.appId];
      if (!app) return null;
      const colorClass = i < 3 ? rankColors[i] : 'border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-950';
      return (
        <div class={`border-2 rounded-xl p-6 ${colorClass}`}>
          <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
            <div class="flex items-center gap-3">
              <span class={`text-sm font-bold px-2.5 py-1 rounded-lg ${i < 3 ? rankBadgeColors[i] : 'bg-gray-200 dark:bg-gray-700 text-gray-600 dark:text-gray-300'}`}>
                {i < 3 ? rankLabels[i] : `#${entry.rank}`}
              </span>
              <div>
                <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100">{app.name}</h3>
                <p class="text-sm text-gray-500 dark:text-gray-400">{app.tagline}</p>
              </div>
            </div>
            <div class="flex items-center gap-3 shrink-0">
              <div class="text-center">
                <div class={`text-2xl font-bold ${entry.score >= 9 ? 'text-green-600 dark:text-green-400' : 'text-blue-600 dark:text-blue-400'}`}>{entry.score}</div>
                <div class="text-xs text-gray-400 dark:text-gray-500">/ 10</div>
              </div>
              <div class="text-center">
                <div class="text-amber-600 dark:text-amber-400 font-bold">⭐ {app.rating}</div>
                <div class="text-xs text-gray-400 dark:text-gray-500">{app.reviewCount.toLocaleString()} reviews</div>
              </div>
            </div>
          </div>

          <!-- Why ranked here -->
          <div class="bg-white dark:bg-gray-900 rounded-lg p-4 mb-4 border border-gray-200 dark:border-gray-700">
            <div class="text-xs font-bold text-blue-600 dark:text-blue-400 uppercase tracking-wide mb-1">Why #{entry.rank}</div>
            <p class="text-sm text-gray-700 dark:text-gray-300">{entry.topReason}</p>
          </div>

          <!-- Pricing + best for grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
            <div>
              <div class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-2">Pricing</div>
              <div class="space-y-1">
                {app.pricing.hasFree && (
                  <div class="text-xs text-green-600 dark:text-green-400 flex items-center gap-1">
                    <span>✓</span><span>Free plan: {app.pricing.freeTier}</span>
                  </div>
                )}
                <div class="text-sm text-gray-700 dark:text-gray-300">
                  From <strong>${app.pricing.startingPrice}/mo</strong> — {app.pricing.pricingModel}
                </div>
              </div>
            </div>
            <div>
              <div class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-2">Best For</div>
              <p class="text-sm text-gray-700 dark:text-gray-300">{app.bestFor}</p>
            </div>
          </div>

          <!-- Pros -->
          <div class="mb-4">
            <div class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-2">Key Strengths</div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-1">
              {app.pros.slice(0, 4).map(pro => (
                <div class="flex items-start gap-2 text-sm text-gray-700 dark:text-gray-300">
                  <span class="text-green-500 mt-0.5 shrink-0">✓</span>
                  <span>{pro}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Buttons -->
          <div class="flex flex-wrap gap-2 mt-2">
            <a href={app.shopifyAppUrl} target="_blank" rel="noopener nofollow sponsored"
              class="text-sm px-4 py-2 bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-900 rounded-lg font-medium hover:opacity-90 transition">
              View on App Store →
            </a>
            {entry.compareLinks.slice(0, 2).map(slug => {
              const pair = PAIRS.find(p => p.slug === slug);
              if (!pair) return null;
              const otherId = pair.app1 === entry.appId ? pair.app2 : pair.app1;
              const other = APPS[otherId];
              if (!other) return null;
              return (
                <a href={`/compare/${slug}/`}
                  class="text-sm px-4 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-lg font-medium hover:border-blue-400 dark:hover:border-blue-500 hover:text-blue-700 dark:hover:text-blue-400 transition">
                  vs {other.name}
                </a>
              );
            })}
          </div>
        </div>
      );
    })}
  </section>

  <!-- Methodology -->
  <section class="mb-10 bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-xl p-5">
    <h2 class="text-base font-bold text-gray-900 dark:text-gray-100 mb-2">How We Ranked These Apps</h2>
    <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
      Rankings are based on: App Store rating &amp; review volume (30%), pricing value (20%), feature depth (20%), Shopify-native integration quality (15%), and community/support quality (15%). We update rankings regularly as apps release new features and pricing changes.
    </p>
  </section>

  <!-- FAQ -->
  <section class="mb-10">
    <h2 class="text-xl font-bold mb-5 text-gray-900 dark:text-gray-100">Frequently Asked Questions</h2>
    <div class="space-y-4">
      {page.faq.map(item => (
        <div class="border border-gray-200 dark:border-gray-700 rounded-xl p-5">
          <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">{item.q}</h3>
          <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">{item.a}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Related comparisons -->
  <section>
    <h2 class="text-lg font-semibold mb-4 text-gray-900 dark:text-gray-100">
      Individual {category?.name} Comparisons
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {PAIRS.filter(p => p.category === page.category).map(pair => (
        <a href={`/compare/${pair.slug}/`}
          class="flex items-center justify-between border border-gray-200 dark:border-gray-700 rounded-xl p-4 hover:border-blue-400 dark:hover:border-blue-600 hover:bg-blue-50 dark:hover:bg-blue-950 transition-all group">
          <span class="font-medium text-gray-900 dark:text-gray-100 group-hover:text-blue-700 dark:group-hover:text-blue-400 text-sm">
            {APPS[pair.app1]?.name} vs {APPS[pair.app2]?.name}
          </span>
          <span class="text-blue-500 dark:text-blue-400 ml-2 group-hover:translate-x-0.5 transition-transform">→</span>
        </a>
      ))}
    </div>
  </section>
</Base>
